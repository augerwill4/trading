//@version=6
// =============================================================================
// GEX Levels
// -----------------------------------------------------------------------------
// Draws the gamma levels that gex-lab computes: the gamma flip, the call wall,
// the put wall and up to three extra high-gamma strikes, plus a background tint
// for the gamma regime.
//
// The numbers are inputs, not calculations. TradingView has no option chain, so
// nothing here can derive gamma on its own — run
//
//     python -m gexlab SPY --max-dte 7
//
// and type the block it prints into this indicator's settings. Levels only move
// when open interest changes, which is overnight, so this is a once-a-morning
// job rather than something that has to stream.
//
// Companion to "Session Levels & Trade Markers" in ../../pine — same drawing
// style, so the two stack on one chart without fighting each other.
// =============================================================================

indicator("GEX Levels", shorttitle = "GEX", overlay = true,
     max_lines_count = 100, max_labels_count = 100)

// ── The levels ───────────────────────────────────────────────────────────────
gL      = "Levels (paste from gexlab)"
flipPx  = input.float(0.0, "Gamma flip", minval = 0.0, step = 0.01, group = gL,
     tooltip = "Above it dealers are long gamma and dampen the tape. Below it they are short gamma and amplify it. The single most important number here.")
cwPx    = input.float(0.0, "Call wall",  minval = 0.0, step = 0.01, group = gL,
     tooltip = "Strike with the heaviest positive call gamma — the shelf rallies tend to stall under.")
pwPx    = input.float(0.0, "Put wall",   minval = 0.0, step = 0.01, group = gL,
     tooltip = "Strike with the heaviest negative put gamma — the shelf selloffs tend to hold at.")
x1Px    = input.float(0.0, "Extra level 1", minval = 0.0, step = 0.01, group = gL)
x2Px    = input.float(0.0, "Extra level 2", minval = 0.0, step = 0.01, group = gL)
x3Px    = input.float(0.0, "Extra level 3", minval = 0.0, step = 0.01, group = gL)

// ── Context ──────────────────────────────────────────────────────────────────
gC      = "Context"
netGex  = input.float(0.0, "Net GEX ($Bn per 1%)", step = 0.001, group = gC,
     tooltip = "Copy the 'Net GEX' figure from the report. Display only — it does not change the drawing.")
stamp   = input.string("", "Computed at", group = gC,
     tooltip = "Paste the timestamp from the report header. A GEX level from two sessions ago is not a level.")
showInfo = input.bool(true, "Show the info table", group = gC)

// ── Appearance ───────────────────────────────────────────────────────────────
gS      = "Appearance"
rightOff = input.int(12, "Extend levels right (bars)", minval = 0, maxval = 400, group = gS)
backBars = input.int(120, "Draw back (bars)", minval = 10, maxval = 5000, group = gS)
showDist = input.bool(true, "Show distance from price on the tags", group = gS)
tintBg   = input.bool(true, "Tint the background by gamma regime", group = gS)
flipCol  = input.color(#eab308, "Gamma flip", inline = "c1", group = gS)
cwCol    = input.color(#22c55e, "Call wall", inline = "c1", group = gS)
pwCol    = input.color(#ef4444, "Put wall",  inline = "c1", group = gS)
xCol     = input.color(#94a3b8, "Extra",     inline = "c1", group = gS)
tintAmt  = input.int(94, "Background tint transparency", minval = 70, maxval = 100, group = gS)

// ── Drawing ──────────────────────────────────────────────────────────────────
transparent = color.new(color.black, 100)

var line[]  lns = array.new_line()
var label[] lbs = array.new_label()

drawLevel(float px, string txt, color col, string style, int width) =>
    if px > 0.0
        leftX  = bar_index - backBars
        rightX = bar_index + rightOff
        tag    = showDist ? txt + "  " + str.tostring(px, format.mintick) +
             "  (" + str.tostring((px / close - 1.0) * 100.0, "+0.00") + "%)"
             : txt + "  " + str.tostring(px, format.mintick)
        array.push(lns, line.new(leftX, px, rightX, px, xloc.bar_index, extend.none, col, style, width))
        array.push(lbs, label.new(rightX, px, tag, xloc.bar_index, yloc.price, transparent,
             label.style_label_left, col, size.small))

if barstate.islast
    // Guarded rather than `for i = 0 to size - 1`: Pine picks the loop
    // direction from the bounds, so an empty array would count 0 down to -1.
    if array.size(lns) > 0
        for i = 0 to array.size(lns) - 1
            line.delete(array.get(lns, i))
    if array.size(lbs) > 0
        for i = 0 to array.size(lbs) - 1
            label.delete(array.get(lbs, i))
    array.clear(lns)
    array.clear(lbs)

    drawLevel(pwPx,   "Put wall",   pwCol,   line.style_solid,  2)
    drawLevel(cwPx,   "Call wall",  cwCol,   line.style_solid,  2)
    drawLevel(x1Px,   "GEX",        xCol,    line.style_dotted, 1)
    drawLevel(x2Px,   "GEX",        xCol,    line.style_dotted, 1)
    drawLevel(x3Px,   "GEX",        xCol,    line.style_dotted, 1)
    drawLevel(flipPx, "Gamma flip", flipCol, line.style_dashed, 2)

// ── Regime tint ──────────────────────────────────────────────────────────────
// Positive gamma above the flip, negative below. The tint is deliberately faint
// — it is a reminder of which playbook is live, not a signal.
posGamma = flipPx > 0.0 and close >= flipPx
negGamma = flipPx > 0.0 and close <  flipPx
bgcolor(tintBg and posGamma ? color.new(cwCol, tintAmt) : na, title = "Positive gamma")
bgcolor(tintBg and negGamma ? color.new(pwCol, tintAmt) : na, title = "Negative gamma")

// ── Info table ───────────────────────────────────────────────────────────────
var table info = table.new(position.top_right, 2, 3, border_width = 1)

if showInfo and barstate.islast
    regime   = flipPx <= 0.0 ? "—" : posGamma ? "Positive (mean revert)" : "Negative (trend)"
    regimeCol = flipPx <= 0.0 ? xCol : posGamma ? cwCol : pwCol
    table.cell(info, 0, 0, "Regime", text_color = color.gray, text_size = size.small)
    table.cell(info, 1, 0, regime, text_color = regimeCol, text_size = size.small)
    table.cell(info, 0, 1, "Net GEX", text_color = color.gray, text_size = size.small)
    table.cell(info, 1, 1, str.tostring(netGex, "+0.000") + " Bn / 1%",
         text_color = netGex >= 0 ? cwCol : pwCol, text_size = size.small)
    table.cell(info, 0, 2, "As of", text_color = color.gray, text_size = size.small)
    table.cell(info, 1, 2, stamp == "" ? "not set" : stamp,
         text_color = stamp == "" ? pwCol : color.gray, text_size = size.small)

// ── Alerts ───────────────────────────────────────────────────────────────────
flipUp = flipPx > 0.0 and ta.crossover(close, flipPx)
flipDn = flipPx > 0.0 and ta.crossunder(close, flipPx)
cwHit  = cwPx   > 0.0 and high >= cwPx and high[1] < cwPx
pwHit  = pwPx   > 0.0 and low  <= pwPx and low[1]  > pwPx

alertcondition(flipUp, "Crossed above gamma flip", "Price crossed above the gamma flip — long-gamma regime")
alertcondition(flipDn, "Crossed below gamma flip", "Price crossed below the gamma flip — short-gamma regime")
alertcondition(cwHit,  "Tagged the call wall",     "Price tagged the call wall")
alertcondition(pwHit,  "Tagged the put wall",      "Price tagged the put wall")
